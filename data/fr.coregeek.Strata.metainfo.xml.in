  <name>Strata</name>
  <summary>Lightweight database client</summary>
  <description>
    <p>Strata is a fast, memory-efficient database client for PostgreSQL and MySQL/MariaDB, built with GTK and libadwaita.</p>
  </description>
  <developer id="fr.coregeek">
    <name>Strata contributors</name>
  </developer>
  <url type="homepage">https://github.com/JikaiNoTsubasa/Strata</url>
